DATABASE_URL=postgresql://energy:energy@localhost:5432/energy
NEXT_PUBLIC_APP_NAME=Nền tảng quản lý năng lượng tỉnh Tây Ninh

# Đường dẫn con khi deploy dưới một sub-path thay vì root domain/subdomain,
# ví dụ https://domain.gov.vn/nang-luong -> NEXT_PUBLIC_BASE_PATH=/nang-luong.
# Để trống nếu deploy trên subdomain riêng (vd: nangluong.tayninh.gov.vn) — trường hợp
# phổ biến nhất và không cần cấu hình gì thêm. Đây là biến build-time (NEXT_PUBLIC_*):
# đổi giá trị này bắt buộc phải build lại image (docker compose build / docker build).
NEXT_PUBLIC_BASE_PATH=

PORT=3113

# GeoServer nội bộ. Ứng dụng proxy WMS/WFS qua cùng domain để tránh lỗi CORS.
GEOSERVER_URL=http://172.16.20.158:8081/geoserver
# Các lớp WMS mặc định hiển thị trên bản đồ; có thể khai báo thêm/bớt lớp, phân tách bằng dấu phẩy.
GEOSERVER_WMS_LAYERS=nangluong_tayninh:du_an_dien_mat_troi_dien_tap_trung, nangluong_tayninh:du_an_dien_sinh_khoi, nangluong_tayninh:du_an_thuy_dien, nangluong_tayninh:duong_day_110kv_long_an_, nangluong_tayninh:duong_day_22kv_tuyen_473_long_an, nangluong_tayninh:khach_hang_dien_mat_troi, nangluong_tayninh:nhanh_re_ubnd_tinh, nangluong_tayninh:phuong_long_an, nangluong_tayninh:tba_110kv_long_an_hc, nangluong_tayninh:tba_ubnd_tinh, nangluong_tayninh:tinh_tay_ninh, nangluong_tayninh:tram_sac, nangluong_tayninh:vi_tri_110kv_long_an, nangluong_tayninh:vi_tri_tuyen_473_22kv
GEOSERVER_USERNAME=
GEOSERVER_PASSWORD=
GEOSERVER_TIMEOUT_MS=20000
GIS_CENTER_LON=106.414
GIS_CENTER_LAT=10.555
GIS_DEFAULT_ZOOM=14

# =========================================================
# AI SERVICE
# Browser không gọi trực tiếp AI service. Các biến bên dưới là server-only,
# ngoại trừ NEXT_PUBLIC_AI_FEATURE_ENABLED.
# =========================================================
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://172.16.10.233:8000
AI_SERVICE_API_VERSION=v1
AI_SERVICE_API_KEY=
AI_SERVICE_AUTH_TYPE=bearer
AI_SERVICE_TIMEOUT_MS=60000
AI_SERVICE_RETRY_COUNT=2
AI_SERVICE_MOCK=false
AI_SERVICE_VERIFY_SSL=true

# Nhiệm vụ 5 — AI nhận diện nguy cơ an toàn điện qua ảnh.
# Endpoint nhận multipart/form-data gồm image, latitude, longitude.
AI_VISION_ENDPOINT=http://172.16.10.233:8000/api/v1/mission5/inspection/analyze
AI_VISION_ASSET_MATCH_MAX_DISTANCE_M=150

# Có thể đổi contract/đường dẫn riêng cho từng nhiệm vụ mà không sửa mã nguồn.
# Giá trị mặc định tương thích nhóm endpoint trong project energy-app cũ.
AI_MISSION_1_ENDPOINT=/mission1/overload/predict
AI_MISSION_2_ENDPOINT=/mission2/solar/forecast
AI_MISSION_2_SAME_PERIOD_FORECAST_ENDPOINT=/mission2/solar/forecast/same-period
AI_MISSION_2_DEMAND_FORECAST_ENDPOINT=/mission2/demand/forecast
AI_MISSION_2_SUPPLY_ALERT_ENDPOINT=/mission2/supply/alert
AI_MISSION_3_ENDPOINT=/mission3/solar-rooftop/recommend
AI_MISSION_4_ENDPOINT=/mission4/reports/validate
AI_MISSION_5_ENDPOINT=/mission5/inspection/analyze
AI_MISSION_6_ENDPOINT=/mission6/emissions/analyze
AI_MISSION_7_ENDPOINT=/mission7/charging/forecast
AI_MISSION_8_ENDPOINT=/mission_oilgas/oilgas/forecast
AI_MISSION_8_HISTORY_ENDPOINT=/mission_oilgas/oilgas/history
AI_EXTERNAL_OILGAS_PLANT_ID=OILGAS-001

# Async AI jobs
AI_JOB_POLL_INTERVAL_MS=2000
AI_JOB_MAX_WAIT_MS=300000

# Upload giới hạn cho các nhiệm vụ đọc tài liệu / computer vision
AI_UPLOAD_MAX_FILE_SIZE_MB=30
AI_UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
AI_UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Swagger demo IDs / defaults. Override these when the provider has different
# asset identifiers; these values are not secrets.
AI_EXTERNAL_OVERLOAD_SUBSTATION_ID=PB-0110D00-VITRI3011679
AI_EXTERNAL_OVERLOAD_CAPACITY_MVA=25
AI_EXTERNAL_SOLAR_PLANT_ID=DMT-001
AI_EXTERNAL_SOLAR_PERIOD_TYPE=day
AI_EXTERNAL_SOLAR_CUSTOMER_ID=PE00123456789
AI_EXTERNAL_DEMAND_PERIOD_TYPE=day
AI_EXTERNAL_SUPPLY_AREA_ID=KV-CANTHO-01
AI_EXTERNAL_SUPPLY_CAPACITY_MW=150
AI_EXTERNAL_SUPPLY_PERIOD_TYPE=day
AI_EXTERNAL_ROOFTOP_CUSTOMER_ID=PE00123456789
AI_EXTERNAL_EFFICIENCY_SEARCH_KEY=1100715331
AI_EXTERNAL_EFFICIENCY_YEAR=2025
AI_EXTERNAL_EFFICIENCY_REPORTED_TOE=22514
AI_EXTERNAL_EV_STATION_ID=STATION-001
AI_EXTERNAL_CARBON_COMPANY_NAME=Công ty TNHH Giày FU-LUH

# Public feature flag, không chứa secret hoặc URL hạ tầng nội bộ.
NEXT_PUBLIC_AI_FEATURE_ENABLED=true
